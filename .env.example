# Variáveis de ambiente necessárias para rodar o projeto (dev local e Vercel).
# Copie este arquivo para `.env.local` para rodar localmente (nunca commitado — já está no .gitignore).
# Em produção, cadastre as mesmas chaves em:
#   https://vercel.com/sq1matheusgsilva-7306s-projects/escolasaas/settings/environment-variables

# ── Supabase (banco de dados, auth e storage) ──────────────────────────────
# Painel do projeto Supabase > Project Settings > API:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mesma página, campo "service_role" — chave secreta, nunca expor no client:
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI (correção de redação, OCR de redação, classificação ENEM) ───────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Twilio (envio de SMS: lembretes, primeiro acesso) ──────────────────────
# Account SID e Auth Token: painel principal do console Twilio
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número comprado/verificado no Twilio (formato E.164, ex: +5511999999999):
# https://console.twilio.com/us1/develop/phone-numbers/manage/incoming
TWILIO_PHONE_NUMBER=

# ── Google OAuth (upload de vídeo para o YouTube pelo professor) ───────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# https://console.cloud.google.com/apis/credentials
# (precisa da YouTube Data API v3 habilitada no projeto)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web Push (notificações push no navegador) ──────────────────────────────
# Não vêm de um site — são geradas localmente com o pacote web-push:
#   npx web-push generate-vapid-keys
# https://www.npmjs.com/package/web-push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo protocolo VAPID, formato "mailto:voce@dominio.com":
VAPID_SUBJECT=

# ── Pixabay (busca de imagens para materiais/trilhas) ──────────────────────
# Crie uma conta gratuita e pegue a chave em:
# https://pixabay.com/api/docs/ (seção "Search Images", parâmetro key)
PIXABAY_API_KEY=

# ── Segredos gerados por você (não vêm de nenhum provedor externo) ─────────
# Strings aleatórias longas — gere localmente, por exemplo:
#   openssl rand -hex 32
# Autentica o cron job diário (/api/cron/lembrete-diario) contra chamadas externas:
CRON_SECRET=
# Assinam os tokens de convite de matrícula e de redefinição de senha:
REGISTRATION_TOKEN_SECRET=
PASSWORD_RESET_TOKEN_SECRET=
# Senha inicial atribuída quando a secretaria cria um usuário (aluno troca no primeiro acesso):
DEFAULT_USER_PASSWORD=

# ── Específicas do deploy ───────────────────────────────────────────────────
# URL pública onde a aplicação está servida (usada em links gerados por e-mail/SMS):
# ex: https://escolasaas.vercel.app ou o domínio customizado que você configurar
NEXT_PUBLIC_APP_URL=

# Opcional — nível de log (padrão "info" se não definido): debug | info | warn | error
LOG_LEVEL=

# NODE_ENV é definido automaticamente pela Vercel — não precisa configurar.
